<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <form action="/listing" method="post">
        <label for="title"> Title: </label>
        <input type="text" placeholder="Enter title" class="newPostCreate" name="title" id="title">
        <br><br>
        <label for="description"> Description: </label>
        <textarea name="description" id="description" placeholder="Give a description"></textarea>
        <br><br>
        <label for="image"> Image(URL): </label>
        <input type="text" placeholder="Enter image url/link" class="newPostCreate" name="image.url" id="image">
        <br><br>
        <label for="price"> Price: </label>
        <input type="number" placeholder="Enter the price per day" class="newPostCreate" name="price" id="price" >
        <br><br>
        <label for="location"> Location: </label>
        <input type="text" placeholder="Enter the location" class="newPostCreate" name="location" id="location">
        <br><br>
        <label for="country"> Country: </label>
        <input type="text" placeholder="Enter the country" class="newPostCreate" name="country" id="country">
        
        <button>Submit</button>
    </form>
</body>
</html>