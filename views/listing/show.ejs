<% layout('/layouts/boilerplate') %>
<body>
    <div class="row show-container">
        <br>
        <div class="col-md-8">
            <h1> Listing Details</h1>
        </div>
        <div class="card col-md-8">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="img-defult">
        
            <div class="card-body">
                <h5><%= listing.title %></h5>
                <h6>&nbsp;&nbsp;&nbsp;<%= listing.description %></h6> 
                <h6>Price: BDT <%= (listing.price??0).toLocaleString("en-bd") %> </h6>
                <p>Location: <%= listing.location %> <br>
                country: <%= listing.country %></p>
            </div>    
        </div>
    </div>
    

    <div class="show-btns">
        <div>

            <a href="/listing/<%= listing._id %>/edit"><button class="btn btn-dark show-btn">Edit</button></a>
             
        </div>
        <div>
            <form action="/listing/<%= listing._id %>?_method=Delete" method="post">
                <button class="btn btn-dark show-btn ">Delete</button>
            </form>

        </div>
    </div>

    <br>
    <hr>

    <div class="row col-sm-6 justify-content-center mx-auto review">
        
        <form action="/listing/<%= listing._id %>/reviews" method="post">
            <h4>Leave a review</h4>
            <label for="rating">Rating</label>
            <input type="range" step="1" min="0" max="5" class="form-range" name="rating" id="rating">
            <textarea class="form-control" name="comment" rows="3" placeholder="write your opinion" id=""></textarea>
                
            <button class="btn btn-outline-dark" type="submit">Add</button>
        </form>
        
    </div>
    
    <div class="row review-listings">
        <%= listing.review. %>
    </div>

</body>
