<% layout('/layouts/boilerplate') %>

<body>
    
    <div class="row show-container ">
        <br>
        <div class="col-md-8">
            <h1> <%= listing.title %> </h1>
        </div>
        <div class="card col-md-8 card-listings">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="img-defult">
        
            <div class="card-body">
                <p> Owned by <b>@<%= username %></b></p>
                <h6>&nbsp;&nbsp;&nbsp;<%= listing.description %></h6> 
                <h6>Price: BDT <%= (listing.price??0).toLocaleString("en-bd") %> </h6>
                <p>Location: <%= listing.location %> <br>
                country: <%= listing.country %></p>
            </div>    
        </div>
    </div>
    
    <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
    <div class="show-btns">
        <div>

            <a href="/listing/<%= listing._id %>/edit"><button class="btn btn-dark show-btn">Edit</button></a>
             
        </div>
        <div>
            <form action="/listing/<%= listing._id %>?_method=Delete" method="post">
                <button class="btn btn-dark show-btn ">Delete</button>
            </form>

        </div>
    </div>
    <% } %>

    <br>
    <hr>

    <!-- Review Form -->
<div class="col-sm-6 mx-auto review">

    <form action="/listing/<%= listing._id %>/reviews"
          method="post"
          novalidate
          class="needs-validation">

        <h4>Leave a review</h4>

        <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
            <input type="radio" id="second-rate1" name="rating" value="1" />
            <label for="second-rate1" title="Terrible">1 star</label>
            <input type="radio" id="second-rate2" name="rating" value="2" />
            <label for="second-rate2" title="Not good">2 stars</label>
            <input type="radio" id="second-rate3" name="rating" value="3" />
            <label for="second-rate3" title="Average">3 stars</label>
            <input type="radio" id="second-rate4" name="rating" value="4" />
            <label for="second-rate4" title="Very good">4 stars</label>
            <input type="radio" id="second-rate5" name="rating" value="5" />
            <label for="second-rate5" title="Amazing">5 stars</label>
        </fieldset>
        <textarea
            required
            class="form-control mb-1"
            name="comment"
            rows="3"
            placeholder="Write your opinion"></textarea>

        <div class="invalid-feedback">
            Please add some comments to review.
        </div>

        <button class="btn btn-outline-dark mb-2 mt-2" type="submit">
            Add
        </button>

    </form>

</div>


<!-- Reviews -->
<div class="col-sm-6 mx-auto review-listings">

    <div class="row g-2">

        <% for(let list of listing.review){ %>

            <div class="col-sm-6">
                <form 
                action="/listing/<%= listing._id %>/reviews/<%= list._id %>?_method=Delete"
                     method="post">

                <div class="card h-100">
                    <div class="card-body">

                        <p class="card-text">
                           <b>@<%= list.author.username %></b> <br>
                           <p class="starability-result" data-rating="<%= list.rating %>">
                            Rated: 3 stars
                            </p>
                            <%= list.comment %>
                        </p>

                        <!-- <p class="card-text">
                            Rating: <%= list.rating %> star
                        </p> -->
                        <button class="btn btn-outline-dark">Delete</button>
                    </div>
                </div>
               </form>

            </div>

        <% } %>

    </div>

</div>

<div class="col-sm-6 mx-auto mb-3 mt-2">
    <div id="map"></div>
</div>

<script>
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
</script>
</body>
