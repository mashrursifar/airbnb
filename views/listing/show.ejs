<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h1> <%= listing.title %></h1>
    <img src="<%= listing.image.url %>" alt="">
    <h4><%= listing.description %></h4>
    <h4>price: <%= listing.price.toLocaleString("en-bd") %> &#2547;</h4>
    <h4>Location: <%= listing.location %></h4>
    <h4>country: <%= listing.country %></h4>

    <button><a href="/listing/<%= listing._id %>/edit">Edit</a></button>
    <br><br>
    <form action="" method="post">
        <button>Delete</button>
    </form>
</body>
</html>