<% layout('/layouts/boilerplate') %>
<body>
    <h1> <%= listing.title %></h1>
    <img src="<%= listing.image.url %>" alt="">
    <br><br>
    <h6>&nbsp;&nbsp;&nbsp;<%= listing.description %></h6> <br>
    <h6>Price: BDT <%= (listing.price??0).toLocaleString("en-bd") %> </h6>
    <p>Location: <%= listing.location %> <br>
    country: <%= listing.country %></p>

    <button><a href="/listing/<%= listing._id %>/edit">Edit</a></button>
    <br><br>
    
    <form action="/listing/<%= listing._id %>?_method=Delete" method="post">
        <button>Delete</button>
    </form>
</body>
