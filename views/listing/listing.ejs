<% layout('/layouts/boilerplate') %>

<body>
    <form action="/listing/new" method="get">
        <button>Create new listing</button>
    </form>
    <h1>All Listings</h1>
    <ul>
        <% for(let listing of allListings){ %>

            <li> <a href="/listing/<%= listing._id %>"><%= listing.title %></a></li>
            
        <% } %>
    </ul>
    
    

    
</body>
